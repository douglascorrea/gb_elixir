# Copy this file to .env or your deployment-specific environment file.
# Do not commit real secrets or deployment-specific private paths.

# Phoenix / release settings
PHX_SERVER=true
PHX_HOST=localhost
PORT=4000
BIND_IP=127.0.0.1
# SECRET_KEY_BASE=generate-with-mix-phx.gen.secret

# Emulator admission control
GB_EMU_MAX_SESSIONS=4

# User upload storage.
# Files are scoped to a signed browser session and retained until this many
# milliseconds pass without that browser reconnecting.
GB_EMU_UPLOAD_TTL_MS=7200000
GB_EMU_UPLOAD_ROOT=/tmp/gb_emu_uploads

# Optional local/default boot ROM. Keep proprietary BIOS files outside git.
# GB_EMU_BOOT_ROM=/absolute/path/to/dmg_boot.bin
